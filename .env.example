# Core application and owner authentication
DATABASE_URL=postgresql://user:password@host/database?sslmode=verify-full
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
OWNER_EMAIL=owner@example.com
PASSKEY_RP_ID=localhost
# Optional after setup. Generate with `openssl rand -hex 32`; bootstrap is refused once any auth user exists.
OWNER_BOOTSTRAP_TOKEN=

# Public lead notifications
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
CONTACT_NOTIFICATION_EMAIL=owner@example.com
CONTACT_FROM_EMAIL=Brandon York | Yorkstead Systems <hello@yorkstead.com>
CONTACT_HASH_SALT=replace-with-an-independent-random-secret
ANALYTICS_HASH_SALT=replace-with-an-independent-random-secret
WORKFLOW_AUDIT_BOOKING_URL=

# Search ownership. Use the content value only, not the complete meta tag.
GOOGLE_SITE_VERIFICATION=

# Optional public business details. Leave unset until Brandon approves them.
BUSINESS_PHONE=
BUSINESS_SERVICE_AREA=
BUSINESS_ADDRESS_APPROVED=false
BUSINESS_STREET_ADDRESS=
BUSINESS_ADDRESS_LOCALITY=
BUSINESS_ADDRESS_REGION=
BUSINESS_POSTAL_CODE=
BUSINESS_ADDRESS_COUNTRY=US

# Private integrations and background jobs
GITHUB_TOKEN=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
CRON_SECRET=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@yorkstead.com
